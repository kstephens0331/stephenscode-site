# Copy this file to .env and fill in real values. Never commit .env -- it is already in .gitignore.

# Stripe secret key (from Stripe Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_or_sk_test_your_key_here

# Stripe webhook signing secret (from Stripe Dashboard -> Developers -> Webhooks -> your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Path to a Firebase Admin SDK service account JSON file for the "customer-stephenscode"
# project (customers + their transactions), used by
# admin.initializeApp({ credential: admin.credential.applicationDefault() }).
# Do not commit the service account file itself either.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Path to a second service account JSON for the "stephenscode-12f75" project (the shared
# orders collection admin-dashboard's Orders.jsx and AddOrder.jsx already use). Checkout
# orders must land here, not in customer-stephenscode, or they're invisible to the admin UI.
ORDERS_SERVICE_ACCOUNT_PATH=./service-account-orders.json

# Comma-separated list of origins allowed to call this API (CORS allowlist)
ALLOWED_ORIGINS=https://www.stephenscode.dev,https://stephenscode.dev,https://customer.stephenscode.dev

# Where Stripe Checkout sends the customer after payment
CHECKOUT_SUCCESS_URL=https://www.stephenscode.dev/checkout/success
CHECKOUT_CANCEL_URL=https://www.stephenscode.dev/pricing

# Shared secret required in the X-Admin-Secret header for /api/checkout/collect-remainder
ADMIN_API_SECRET=choose-a-long-random-value

# Port the server listens on (defaults to 3000 in server.js if unset)
PORT=3000
